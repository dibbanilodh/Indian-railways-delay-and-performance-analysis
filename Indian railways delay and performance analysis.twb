      <aliases enabled='yes' />
      <column caption='Delay Range' datatype='string' name='[Calculation_0049240672165888]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([average_delay_minutes])&lt;=30 THEN &quot;0-30min&quot;&#13;&#10;ELSEIF ([average_delay_minutes])&lt;=60 THEN &quot;31-60min&quot;&#13;&#10;ELSEIF ([average_delay_minutes])&lt;=120 THEN &quot;61-120min&quot;&#13;&#10;ELSEIF ([average_delay_minutes])&lt;=180 THEN &quot;121-180min&quot;&#13;&#10;ELSE &quot;180+ min&quot;&#13;&#10;END' />
      </column>
      <column caption='Total Trains' datatype='integer' name='[Calculation_1327697121812480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([train_number])' />
      </column>
      <column caption='Total Stations' datatype='integer' name='[Calculation_1327697123155970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([station_code])' />
      </column>
      <column caption='avg delay' datatype='real' name='[Calculation_1327697124634627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([average_delay_minutes])' />
      </column>
      <column caption='max delay' datatype='integer' name='[Calculation_1327697128910852]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([average_delay_minutes])' />
      </column>
      <column caption='min delay' datatype='integer' name='[Calculation_1327697129566213]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN([average_delay_minutes])' />
      </column>
      <column caption='delay category' datatype='string' name='[Calculation_1327697134239750]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [average_delay_minutes]&lt;=20 THEN &quot;Low Delay&quot;&#13;&#10;ELSEIF [average_delay_minutes]&lt;=60 THEN &quot;Medium Delay&quot;&#13;&#10;ELSE &quot;High delay&quot;&#13;&#10;END' />
